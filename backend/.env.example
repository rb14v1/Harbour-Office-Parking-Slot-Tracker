# Copy to .env and replace the placeholder values. Never commit .env.

# development | production. Production refuses to start with the default JWT secret.
ENVIRONMENT=development

# Local MongoDB (MongoDB Community Server) or MongoDB Atlas connection string.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=parking_tracker

# Long random string. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Optional: override the development seed passwords used by backend/scripts/seed.py.
# SEED_ADMIN_PASSWORD=
# SEED_EMPLOYEE_PASSWORD=
